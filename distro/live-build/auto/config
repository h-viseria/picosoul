#!/bin/sh
# live-build auto/config — PicoSoul Bookworm live (no installer).
set -e

# Bookworm mirrors: security suite is "bookworm-security" under
# security.debian.org/debian-security (NOT bookworm/updates).
# Ubuntu's ancient live-build gets this wrong — CI installs Debian live-build.
# Firmware packages are listed in package-lists; disable auto firmware pull.
lb config noauto \
  --mode debian \
  --distribution bookworm \
  --archive-areas "main contrib non-free non-free-firmware" \
  --parent-archive-areas "main contrib non-free non-free-firmware" \
  --mirror-bootstrap "http://deb.debian.org/debian/" \
  --mirror-chroot "http://deb.debian.org/debian/" \
  --mirror-binary "http://deb.debian.org/debian/" \
  --mirror-chroot-security "http://security.debian.org/debian-security/" \
  --mirror-binary-security "http://security.debian.org/debian-security/" \
  --parent-mirror-chroot-security "http://security.debian.org/debian-security/" \
  --parent-mirror-binary-security "http://security.debian.org/debian-security/" \
  --security true \
  --updates true \
  --binary-images iso-hybrid \
  --debian-installer none \
  --bootappend-live "boot=live components quiet splash username=picosoul hostname=picosoul persistence" \
  --iso-application "PicoSoul" \
  --iso-preparer "PicoSoul; https://github.com/h-viseria/picosoul" \
  --iso-publisher "PicoAI; https://picoai.org/picosoul/" \
  --iso-volume "PICOSOUL" \
  --memtest none \
  --win32-loader false \
  --apt-indices false \
  --apt-recommends false \
  --firmware-binary false \
  --firmware-chroot false \
  --cache true \
  --debootstrap-options "--keyring=/usr/share/keyrings/debian-archive-keyring.gpg" \
  "${@}"
